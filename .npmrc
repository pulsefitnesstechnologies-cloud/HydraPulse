auto-install-peers=false
strict-peer-dependencies=false
# EAS builds on macOS; the lockfile is generated on Replit (Linux) with
# platform-specific esbuild overrides. Disabling frozen-lockfile lets EAS
# regenerate it correctly for its own platform instead of erroring out.
frozen-lockfile=false
# Hoist expo CLI to the workspace root so EAS can run "pnpm expo prebuild"
# from the monorepo root without a --filter flag.
public-hoist-pattern[]=expo
public-hoist-pattern[]=@expo/cli
