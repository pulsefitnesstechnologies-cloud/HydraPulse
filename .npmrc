auto-install-peers=false
strict-peer-dependencies=false
frozen-lockfile=false
# Hoist expo and expo-router to the workspace root so that:
#   1. `pnpm expo prebuild` works from the monorepo root (expo binary)
#   2. ROOT/package.json "main": "expo-router/entry" resolves correctly
# Everything else stays in the default pnpm symlink structure so
# Podfile paths (../node_modules/react-native-screens etc.) work too.
public-hoist-pattern[]=expo
public-hoist-pattern[]=@expo/cli
public-hoist-pattern[]=expo-router
